// Security rules for the community-stats backend (see web/js/firebase.js for the client side, README.md for the
// threat-model notes). Everyone who loads the game signs in anonymously first, so `request.auth` is always set for
// a real player; there is no other account system and nothing here ever stores a name, email or IP.
//
// Threat model, stated plainly: there is no server verifying a puzzle was actually solved (that would need a Cloud
// Function, which needs the paid Blaze plan). These rules stop the cheap version of tampering — writing arbitrary
// numbers into the aggregate, resubmitting the same puzzle to pad it, or forging someone else's uid — but a
// determined person with devtools open could still fabricate one plausible-looking play per anonymous identity they
// create. That's an accepted limitation of a free, backend-less setup, not an oversight.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // Map field access that treats a missing key as its zero value instead of throwing, since a doc's first-ever
    // write may not touch every field yet (a puzzle whose first finisher lost has no `hist`/`firstWord`/`lastWord` at all).
    function num(d, key) {
      return d.get(key, 0);
    }
    function mapf(d, key) {
      return d.get(key, {});
    }

    function isValidStats(d) {
      return num(d, 'attempts') is int && num(d, 'attempts') >= 0
        && num(d, 'count') is int && num(d, 'count') >= 0 && num(d, 'count') <= num(d, 'attempts')
        && num(d, 'sumScore') is int && num(d, 'sumScore') >= 0
        && mapf(d, 'hist') is map
        && mapf(d, 'firstWord') is map
        && mapf(d, 'lastWord') is map;
    }

    // A single finish may move the aggregate by exactly the amount one real play contributes: always +1 attempt;
    // only on a win, +1 to count, the winning score added to sumScore, +1 to exactly one histogram bucket, +1 to
    // exactly one first-word bucket, and +1 to exactly one last-word bucket. Anything else (bulk increments,
    // touching two buckets, negative deltas) is refused.
    function isPlausibleDelta(before, after) {
      let attemptsDelta = num(after, 'attempts') - num(before, 'attempts');
      let countDelta = num(after, 'count') - num(before, 'count');
      let scoreDelta = num(after, 'sumScore') - num(before, 'sumScore');
      return attemptsDelta == 1
        && countDelta >= 0 && countDelta <= 1
        && (countDelta == 0
              ? scoreDelta == 0 && mapf(after, 'hist') == mapf(before, 'hist')
                && mapf(after, 'firstWord') == mapf(before, 'firstWord') && mapf(after, 'lastWord') == mapf(before, 'lastWord')
              : scoreDelta >= 1 && scoreDelta <= 500
                && mapf(after, 'hist').diff(mapf(before, 'hist')).affectedKeys().size() == 1
                && mapf(after, 'firstWord').diff(mapf(before, 'firstWord')).affectedKeys().size() == 1
                && mapf(after, 'lastWord').diff(mapf(before, 'lastWord')).affectedKeys().size() == 1);
    }

    // A puzzleStats write is only accepted from a uid that has already created its own (create-once, never reused)
    // plays record for that puzzle, tying the two collections together without needing a shared transaction.
    function hasPlayRecord(puzzleId) {
      return exists(/databases/$(database)/documents/plays/$(puzzleId + '_' + request.auth.uid));
    }

    // BANNED_INITIALS is a moderate, non-exhaustive denylist of common profanity/slurs (and obvious digit-for-
    // letter substitutions) that fit in 3 characters - not a claim of completeness, and not meant to be the only
    // check: web/js/initials.js has the identical list and is what the client checks before ever attempting a
    // write. If one changes, update the other to match.
    function isCleanInitials(s) {
      return s is string && s.matches('^[A-Z0-9]{3}$') && !(s in [
        'ASS', 'A55', '4SS', 'FAG', 'F4G', 'CUM', 'CVM', 'TIT', 'T1T', 'SOB',
        'FUK', 'FCK', 'PHK', 'SHT', 'SH1', 'DIK', 'DIC', 'JIZ', 'CNT', 'KKK',
        'NIG', 'N1G', 'SEX', 'S3X', 'HOE', 'H0E', 'SLT', 'PIS', 'PSS', 'TWA',
        'COK', 'C0K', 'COC', 'BJS', 'PRK', 'RTA', 'FUC', 'WOP', 'GOK', 'SPC',
        'KYK', 'CHK', 'NGR'
      ]);
    }
    function validLbEntry(e) {
      return e.initials is string && isCleanInitials(e.initials)
        && e.links is int && e.links >= 1 && e.links <= 500
        && e.hops is int && e.hops >= e.links && e.hops <= 6000;
    }
    // Both helpers treat "index doesn't exist in this list" as vacuously fine, so a shorter-than-10 list only
    // ever gets checked at the indices it actually has.
    function lbEntryOk(d, i) {
      return d.entries.size() <= i || validLbEntry(d.entries[i]);
    }
    function lbSortedOk(d, i) {
      return d.entries.size() <= i || d.entries[i - 1].links >= d.entries[i].links;
    }
    function isValidLeaderboard(d) {
      return d.entries is list && d.entries.size() >= 1 && d.entries.size() <= 10
        && lbEntryOk(d, 0) && lbEntryOk(d, 1) && lbEntryOk(d, 2) && lbEntryOk(d, 3) && lbEntryOk(d, 4)
        && lbEntryOk(d, 5) && lbEntryOk(d, 6) && lbEntryOk(d, 7) && lbEntryOk(d, 8) && lbEntryOk(d, 9)
        && lbSortedOk(d, 1) && lbSortedOk(d, 2) && lbSortedOk(d, 3) && lbSortedOk(d, 4) && lbSortedOk(d, 5)
        && lbSortedOk(d, 6) && lbSortedOk(d, 7) && lbSortedOk(d, 8) && lbSortedOk(d, 9);
    }

    // One immutable record per player per daily puzzle. The client never reads these back — the aggregate below
    // covers the UI — they exist so `hasPlayRecord` has something concrete to check, and so the raw data could be
    // recomputed or audited later if that's ever needed.
    match /plays/{playId} {
      allow read: if false;
      allow update, delete: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && playId == (string(request.resource.data.puzzle) + '_' + request.auth.uid)
        && request.resource.data.puzzle is int && request.resource.data.puzzle > 0 && request.resource.data.puzzle < 100000
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 500
        && request.resource.data.par is int && request.resource.data.par >= 1 && request.resource.data.par <= 20
        && request.resource.data.won is bool
        && request.resource.data.path is list && request.resource.data.path.size() <= 120
        && request.resource.data.ts == request.time;
    }

    // Public, anonymised aggregate per puzzle: totals, a score histogram, and first/last-word frequency maps. No PII — the only
    // identity anywhere in this project is a random anonymous-auth uid, which isn't stored on this document at all.
    match /puzzleStats/{puzzleId} {
      allow read: if isSignedIn();
      allow delete: if false;
      // A fresh doc's histogram/word maps must have exactly as many keys as its win count (0 for a first-ever
      // loss, 1 for a first-ever win) — this is what actually catches a client sending a malformed nested field
      // (e.g. a literal "hist.5" field instead of a real hist map), which isValidStats alone can't see, since a
      // missing/wrong-shaped map still passes the loose "is a map" check via mapf()'s default.
      allow create: if isSignedIn() && hasPlayRecord(puzzleId) && isValidStats(request.resource.data)
        && num(request.resource.data, 'attempts') <= 1 && num(request.resource.data, 'count') <= 1
        && mapf(request.resource.data, 'hist').size() == num(request.resource.data, 'count')
        && mapf(request.resource.data, 'firstWord').size() == num(request.resource.data, 'count')
        && mapf(request.resource.data, 'lastWord').size() == num(request.resource.data, 'count');
      allow update: if isSignedIn() && hasPlayRecord(puzzleId) && isValidStats(request.resource.data)
        && isPlausibleDelta(resource.data, request.resource.data);
    }

    // The global top-10 longest chains for endless mode, with 3-character arcade-style initials. A single fixed
    // doc holding the whole sorted list, since Firestore has no atomic "insert into sorted array" primitive - the
    // client reads, merges, re-sorts and writes the whole thing back. That (not an oversight) is why this can't be
    // locked down as tightly as a single-value record: rules can validate that a submitted list is well-formed
    // (at most 10 entries, each one in-bounds, descending by links, initials not on the denylist above), but not
    // that it's *specifically* the previous list plus one genuine new entry - a determined tamperer could submit
    // an entirely fabricated top-10 in one write, same "no server verifies a chain was actually played" limitation
    // as the rest of this file, just with a larger blast radius per successful attempt than a single-value record
    // would have. The one thing this can and does check: a write may never lower the current #1 score, so a bad or
    // buggy write can't clobber good data with something worse.
    match /leaderboard/top10 {
      allow read: if isSignedIn();
      allow delete: if false;
      allow create: if isSignedIn() && isValidLeaderboard(request.resource.data);
      allow update: if isSignedIn() && isValidLeaderboard(request.resource.data)
        && (resource.data.entries.size() == 0
              || request.resource.data.entries[0].links >= resource.data.entries[0].links);
    }
  }
}
